diff --git a/src/bits.c b/src/bits.c
index 556f9bc..0d7eb09 100644
--- a/src/bits.c
+++ b/src/bits.c
@@ -1612,8 +1612,15 @@ bit_read_fixed (Bit_Chain *restrict dat, BITCODE_RC *restrict dest,
     }
   else
     {
+      /* 빠른 경로: 비트가 어긋난 바이트들을 한 번에 이어 붙인다 */
+      const unsigned char *src = &dat->chain[dat->byte];
+      const unsigned sh = dat->bit, rs = 8 - dat->bit;
       for (size_t i = 0; i < length; i++)
-        dest[i] = bit_read_RC (dat);
+        dest[i] = (unsigned char)((src[i] << sh) | (src[i + 1] >> rs));
+      dat->byte += length;
+      if (0)
+        for (size_t i = 0; i < length; i++)
+          dest[i] = bit_read_RC (dat);
     }
   return 0;
 }
